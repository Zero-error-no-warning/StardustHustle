}


export void update(){
    auto itemViewer = (ItemState item){
                return styled(atlas.addTexture(itemDatabase[item.itemID].icon.assetPath()),Vec2(0,0)).height(height)
                        ~ (styled(" " ~ item.getName()).color(Color(150,240,255,255))
                        ~ styled(" " ~ itemDataView(item)).color(Color(100,240,190,255))).height(height*0.9).font(font);
            };
    auto itemSort = (ItemState a, ItemState b){
        
    };
    foreach(key,list;InventoryLists){
        list.richContents = ItemLists[key].filter((ItemState item)=>
        itemFilterCombo.selectedText == "" || itemFilterCombo.selectedText == "すべて" || itemDatabase[item.itemID].type == itemTypeComboText[itemFilterCombo.selectedText] ).quickSort(itemSort).map(itemViewer);
    }   
    
    auto mainCapacityScroll = scenes.inventoryUI.findScene("mainCapacityScroll");
    auto pocketCapacityScroll = scenes.inventoryUI.findScene("pocketCapacityScroll");
    auto mainCapacityLabel = scenes.inventoryUI.findScene("mainCapacityLabel");
    auto pocketCapacityLabel = scenes.inventoryUI.findScene("pocketCapacityLabel");
    
    auto mainCapacity = calcCapacity( ItemLists.main);
    auto pocketCapacity = calcCapacity( ItemLists.pocket);
    mainCapacityScroll.viewportExtent = mainCapacity;
    pocketCapacityScroll.viewportExtent = pocketCapacity;
    mainCapacityScroll.contentExtent = inventoryProfile.capacity;
    pocketCapacityScroll.contentExtent =  pocketProfile.capacity;
    mainCapacityScroll.value = 0;
    pocketCapacityScroll.value = 0;

    mainCapacityLabel.caption  = mainCapacity ~ " / " ~ inventoryProfile.capacity;
    pocketCapacityLabel.caption = pocketCapacity ~ " / " ~ pocketProfile.capacity;

}

ItemState[] quickSort(ItemState[] inventory, any cmp){
    if(inventory.length <= 1) return inventory;
    auto pivot = inventory[0];
    ItemState[] less;
    ItemState[] greater;
    foreach(i; 1 .. inventory.length){
        if(cmp(inventory[i], pivot)){
            less ~= inventory[i];
        }else{
            greater ~= inventory[i];
        }
    }
    return quickSort(less, cmp) ~ [pivot] ~ quickSort(greater, cmp);
}
    

export void addItem(ItemState item,string listName,int N  ){
    if(itemDatabase[item.itemID].stackable)
    foreach(existingItem ; ItemLists[listName]){
        if(existingItem.id == item.id){
            existingItem.count +=  N>0 ? N : item.count;
            return;
        }
    }
    auto newItem = {...item,count = N > 0 ? N : item.count};
    ItemLists[listName] ~= newItem;
}

export void removeItem(ItemState item,string listName,int N ){
    foreach(idx,existingItem ; ItemLists[listName]){
        if(existingItem.id == item.id){
            if(itemDatabase[item.itemID].stackable) existingItem.count -= N>0 ? N : item.count;
            if(!itemDatabase[item.itemID].stackable || existingItem.count <= 0){
                ItemLists[listName] = ItemLists[listName][0..idx] ~ ItemLists[listName][idx+1..$];
            }
            return;
        }
    }
}

int countItem(ItemState item,string listName){
    foreach(existingItem ; ItemLists[listName]){
        if(existingItem.id == item.id){
            return existingItem.count;
        }
    }
    return 0;
}

export void moveItem(ItemState item,string fromList,string toList,int N){
    auto selectedNum = InventoryLists[fromList].selectedNum;

    N = N > item.count ? item.count : N;
    removeItem(item,fromList,N);
    addItem(item,toList,N);
 
    listSelected(fromList, selectedNum);
}

export void holdItem(ItemState item,string listName){
    
    if(!item ) return;

    auto itemData = itemDatabase[item.itemID];
    if(itemData.equipSlot != "weapon") return;

    foreach(key,list;InventoryLists){
        list.enabled = false;
    }

    auto equipItem = equipItemList[itemData.equipSlot];
    if(equipItem){
        addItem(equipItem, listName,1);
    }
    equipItemList[itemData.equipSlot] = {...item,count = 1};
    removeItem(item,listName,1);
    auto inventorySceneMaster = scenes.root.master;
    
    auto particle = scenes.previewCanvas.particleEffect;
    auto backPanel = scenes.inventoryUI.previewPanel;
    auto t0 = 0.5;
    auto t = t0;
    scenes.inventoryUI.previewPanel.isVisible = false;
        
    self.miniScene = [
        miniWhile(()=>t>0,(){
            particle.endColor = particle.endColor *Color(64,64,64,255);
            particle.lifetime = {min = t*0.5,max = t};
            particle.emit(t/t0*100);
            t -= Timer.dt;
        }),
        (){
            inventorySceneMaster.isOFF = true;
        }
    ];
}

