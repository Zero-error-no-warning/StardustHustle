};

///////// Inventory Functions //////////


auto canvas =null;
auto atlas = null;


auto InventoryLists = {
    main = scenes.inventoryUI.findScene("mainInventoryList"),
    pocket =  scenes.inventoryUI.findScene("pocketInventoryList"),
};


    
auto previewCanvas = scenes.previewCanvas;

auto itemDataView = (ItemState item) => item.count;

auto height = 20;

Font.registerFile(assetPath("../res/font/madoufmg.ttf"));
auto font = Font("魔導太丸ゴシック",height*2,6,Font.Type.AA16x16_Edge);

ItemState selectedItem = null;
alias ItemListNames = "main" | "pocket" | "";
ItemListNames selectedListName = "";

auto itemFilterCombo = null;
alias ItemFilterComboTypes = idata.ItemType | "all";
ItemFilterComboTypes[string] itemTypeComboText = [
    "すべて" : "all",
    "近接武器" : "weapon_melee",
    "遠距離武器" : "weapon_ranged",
    "銃パーツ" : "gun_parts",
    "魔法石" : "magic_stone",
    "弾" : "ammo",
    "食料" : "food",
    "防具" : "armor",
    "回復" : "medicine",
    "その他" : "misc",
];
export auto sharedVar = {
    currentModel = "",
};
export CharacterAsset[string] itemAssets = [:];

export void open(){
    scenes.inventoryUI.previewPanel.isVisible = true;
    foreach(list;InventoryLists) list.enabled = true;
}

export void init(){


    canvas = self.targetCanvas();
    atlas = canvas.atlas;

    auto base = self.theme.base;
    base.font = font;
    self.editThemeBase(base);

    ComboBox viewDataTypeCombo = scenes.inventoryUI.findScene("viewDataTypeCombo");
    viewDataTypeCombo.contents = 
    ["数量",
    "かさばり",
    "入手順",
    "攻撃力 鋭",
    "攻撃力 硬",
    "防御力 柔",
    "防御力 堅",
    "回復",
    "満腹度",
    ];

    viewDataTypeCombo.onSelected = (long idx){
        switch(idx){
            case 0:
                itemDataView = (ItemState item) => "( " ~ item.count ~" )";
                break;
            case 1:
                itemDataView = (ItemState item) => "( " 
                    ~ cast(int)(cast(int)(calcCapacity([item]))) 
                    ~ " @ " ~ cast(int)calcCapacity([{...item,count = 1}]) ~" )";
                break;
            case 2:
                itemDataView = (ItemState item){
                    if(item.datetime == null) return "不明";
                    auto cur = Timer.currDateTime();
                    bool dY =  item.datetime.year == cur.year;
                    bool dM =  item.datetime.month == cur.month;
                    bool dD =  item.datetime.day == cur.day;
                    bool dh =  item.datetime.hour == cur.hour; 
                    bool dm =  item.datetime.minute == cur.minute;
                    bool ds =  item.datetime.second == cur.second;
                    if(dY && dM && dD && dh && dm && ds) return "たった今";
                    if(dY && dM && dD && dh && dm) return "数秒前";
                    if(dY && dM && dD && dh) return "数分前";
                    if(dY && dM && dD) return "数時間前";
                    if(dY && dM) return "数日前";
                    if(dY) return "数か月前";
                    return "不明";
                };
                break;
        }
    };
    viewDataTypeCombo.select(0);


   foreach(key,list;InventoryLists){
        InventoryLists[key].onClick = (ListView list, long idx){
            listSelected(key, idx);
        };
        InventoryLists[key].onDoubleClick = (ListView list, long idx){
            holdItem(selectedItem,key);
        };
   }


    auto particle = scenes.previewCanvas.particleEffect;
    particle.stop();

    scenes.inventoryUI.findScene("moveItemButton").onClick = (Button b){
        if(selectedItem && selectedListName != ""){
            auto from = selectedListName;
            auto to = selectedListName == "main" ? "pocket" :"main"; 
            moveItem(selectedItem, from, to, 1);
        }
    };

    auto window = scenes.inventoryUI.itemMoveWindow;
    scenes.inventoryUI.findScene("moveItemButtonxN").onClick = (Button b){
        if(!selectedItem) return;
        auto from = selectedListName;
        auto to = selectedListName == "main" ? "pocket" :"main"; 
        scenes.inventoryUI.mainPanel.enabled = false;
        window.isOFF = false;

        window.panel.itemoMoveWindowSlider.minimum = 1;
        window.panel.itemoMoveWindowSlider.maximum = selectedItem.count;
        window.panel.itemoMoveWindowSlider.value = 1;
        window.panel.itemoMoveWindowLabel.caption = 1;
        window.panel.itemoMoveWindowSlider.onChanged = (double value){
            auto ivalue = cast(int)(value);
            window.panel.itemoMoveWindowSlider.value = ivalue;
            window.panel.itemoMoveWindowLabel.caption = ivalue;
        };
        import math;
        window.panel.itemoMoveWindowx10.onClick = (Button b){
            auto value = window.panel.itemoMoveWindowSlider.value;
            value = math.fmin(value + 10, selectedItem.count);
            window.panel.itemoMoveWindowSlider.value = value;
            window.panel.itemoMoveWindowLabel.caption = value;
        };
        window.panel.itemoMoveWindow50p.onClick = (Button b){
            auto value = window.panel.itemoMoveWindowSlider.value;
            value = cast(int)(selectedItem.count / 2);
            window.panel.itemoMoveWindowSlider.value = value;
            window.panel.itemoMoveWindowLabel.caption = value;
        };
        window.panel.itemoMoveWindow100p.onClick = (Button b){
            auto value = window.panel.itemoMoveWindowSlider.value;
            value = selectedItem.count;
            window.panel.itemoMoveWindowSlider.value = value;
            window.panel.itemoMoveWindowLabel.caption = value;
        };
        window.panel.itemoMoveWindowOK.onClick = (Button b){
            auto value = window.panel.itemoMoveWindowSlider.value;
            moveItem(selectedItem, from, to, cast(int)(value));
            window.close();
        };
        window.panel.itemoMoveWindowCancel.onClick = (Button b){
        scenes.inventoryUI.mainPanel.enabled = true;
            window.close();
        };
    };

    window.onClose = (){
        scenes.inventoryUI.mainPanel.enabled = true;
    };

    itemFilterCombo = scenes.inventoryUI.findScene("itemFilterCombo");
    itemFilterCombo.contents = itemTypeComboText.keys();
    itemFilterCombo.caption = "種類";
}

 auto onInventoryClick = (string listName, long idx){
    foreach(sub;previewCanvas.subs){
        if(sub.type == "Character")
            sub.exit();
    }
    print(listName,idx);
    auto item = ItemLists[listName][idx];
    selectedItem = item;
    
    if(itemDatabase[item.itemID].model != ""){
        string path = itemDatabase[item.itemID].model.assetPath();
        if(!itemAssets.contains(path)) 
            itemAssets[path] = loadCharacterAsset(path);

        Character model = itemAssets[path].spawn(previewCanvas);
        auto LeftTop = model.p;
        auto RightBot = model.p;
        model.selectMotion(0,0.0);
        auto modelCenter = model.part("modelCenter");
        previewCanvas.camera.p = modelCenter.p;
        previewCanvas.light.p = modelCenter.p - Vec2(15,15);
        previewCanvas.light.z = modelCenter.thick + 15 ;
        scenes.previewCanvas.particleEffect.p = modelCenter.p;
        sharedVar.currentModel = path;
    }

    auto itemNameLabel = scenes.inventoryUI.findScene("itemName");
    itemNameLabel.richCaption = styled(atlas.addTexture(itemDatabase[item.itemID].icon.assetPath()),Vec2(0,0)).height(height) ~ styled(" " ~ item.getName()).color(Color(150,240,255,255)).font(font).height(height);
    auto itemInfoSystem = scenes.inventoryUI.findScene("itemInfoSystem");
};

void listSelected(string listName, long idx){
    if(idx >= 0 && idx < ItemLists[listName].length){
        foreach(key,list;InventoryLists){
            if(key != listName)
                list.unSelect();
        }
        onInventoryClick(listName, idx);
        selectedListName = listName;
    }
    else{
        selectedItem = null;
        selectedListName = "";
    }
}

import math;
export double calcCapacity(ItemState[] items){
    auto sqrt = math.sqrt;
    auto tidyCap = 0.0;
    auto messyCap = 0.0;
    auto totalWeight = 0.0;
    auto totalSize = 0.0;
    foreach(item ; items){
        auto itemdata = itemDatabase[item.itemID];
        auto count = item.count;
        auto weight = idata.getActualWeight(item);
        auto size = idata.getActualSize(item);
        messyCap += count * sqrt(weight*weight + size*size)*100;
        totalWeight += count * weight;
        totalSize += count * size;
    }
    tidyCap = sqrt(totalWeight*totalWeight + totalSize*totalSize)*100;
    auto t = inventoryProfile.tidiable;
    return messyCap*(1.0-t)+tidyCap*t;
}



