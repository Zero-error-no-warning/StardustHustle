// Sceneごとの状態: instance int count = 0;
// selfはこのコードを割り当てたSceneです。
import ui;
import scenes;

import "./database/itemData.dua" as idata;

auto getName = idata.getName;
alias ItemInfo = idata.ItemInfo;
auto itemDatabase = idata.itemDatabase;

////////// Inventory Data ////////// #mark: 

export ItemInfo[idata.EquipSlot] equipItemList = [
    "weapon": null,
    "none": null,
    "head": null,
    "body": null,
    "waist": null,
];

auto ItemLists = {
    main = [
        ItemInfo{ id = 1, itemID = "knife_001", count = 1, name = "ナイフ", modifier = [] , datetime = null, InstalledPartIDs = [:]},
        ItemInfo{ id = 2, itemID = "handgun_A", count = 1, name = "拳銃", modifier = [] , datetime = null, InstalledPartIDs = [:] },
        // { id = 5, itemID = "barrel_001", count = 1, name = "バレル", modifier = ["長い"] , datetime = null, InstalledPartIDs = [:] },
    ],
        pocket= [
        ItemInfo{ id = 4, itemID = "bandage", count = 5, name = "", modifier = [] , datetime = null, InstalledPartIDs = [:] },
        ItemInfo{ id = 3, itemID = "knife_001", count = 1, name = "ナイフ2", modifier = [] , datetime = null, InstalledPartIDs = [:] },
    ],
};

export auto inventoryProfile = {
    capacity = 1000,
    tidiable = 0,
};

export auto pocketProfile = {
    capacity = 200,
    tidiable = 0,
};

///////// Inventory Functions //////////


auto canvas =null;
auto atlas = null;

ListView mainInventoryList = scenes.inventoryUI.findScene("mainInventoryList");
ListView pocketInventoryList = scenes.inventoryUI.findScene("pocketInventoryList");

    
auto previewCanvas = scenes.previewCanvas;

auto itemDataView = (ItemInfo item) => item.count;

auto height = 20;

Font.registerFile(assetPath("../res/font/madoufmg.ttf"));
auto font = Font("魔導太丸ゴシック",height*2,6,Font.Type.AA16x16_Edge);

ItemInfo selectedItem = null;
export auto sharedVar = {
    currentModel = "",
};
export CharacterAsset[string] itemAssets = [:];

export void open(){
    scenes.inventoryUI.previewPanel.isVisible = true;
    mainInventoryList.enabled = true;
    pocketInventoryList.enabled = true;
}

export void init(){


    canvas = self.targetCanvas();
    atlas = canvas.atlas;
    print("canvas:" ~canvas);
    print("atlas:"~atlas);

    auto base = self.theme.base;
    base.font = font;
    self.editThemeBase(base);

    ComboBox viewDataTypeCombo = scenes.inventoryUI.findScene("viewDataTypeCombo");
    viewDataTypeCombo.richContents = [styled("数量"),styled("嵩張",Ruby("かさば"))~"り",styled("入手順")];

    viewDataTypeCombo.onSelected = (long idx){
        switch(idx){
            case 0:
                itemDataView = (ItemInfo item) => "( " ~ item.count ~" )";
                break;
            case 1:
                itemDataView = (ItemInfo item) => "( " ~ cast(int)(Vec2(itemDatabase[item.itemID].commonStats.weight,itemDatabase[item.itemID].commonStats.size).norm*100 * item.count) ~" )";
                break;
            case 2:
                itemDataView = (ItemInfo item){
                    if(item.datetime == null) return "不明";
                    auto cur = Timer.currDateTime();
                    bool dY =  item.datetime.year == cur.year;
                    bool dM =  item.datetime.month == cur.month;
                    bool dD =  item.datetime.day == cur.day;
                    bool dh =  item.datetime.hour == cur.hour; 
                    bool dm =  item.datetime.minute == cur.minute;
                    bool ds =  item.datetime.second == cur.second;
                    if(dY && dM && dD && dh && dm && ds) return "たった今";
                    if(dY && dM && dD && dh && dm) return "数秒前";
                    if(dY && dM && dD && dh) return "数分前";
                    if(dY && dM && dD) return "数時間前";
                    if(dY && dM) return "数日前";
                    if(dY) return "数か月前";
                    return "不明";
                };
                break;
        }
    };
    viewDataTypeCombo.select(0);


    auto onInventoryClick = (string listName, long idx){
        foreach(sub;previewCanvas.subs){
            if(sub.type == "Character")
                sub.exit();
        }
        auto item = ItemLists[listName][idx];
        selectedItem = item;
        
        if(itemDatabase[item.itemID].model != ""){
            string path = itemDatabase[item.itemID].model.assetPath();
            if(!itemAssets.contains(path)) 
                itemAssets[path] = loadCharacterAsset(path);

            Character model = itemAssets[path].spawn(previewCanvas);
            auto LeftTop = model.p;
            auto RightBot = model.p;
            model.selectMotion(0,0.0);
            auto modelCenter = model.part("modelCenter");
            previewCanvas.camera.p = modelCenter.p;
            previewCanvas.light.p = modelCenter.p - Vec2(15,15);
            previewCanvas.light.z = modelCenter.thick + 15 ;
            scenes.previewCanvas.particleEffect.p = modelCenter.p;
            sharedVar.currentModel = path;
        }

        auto itemNameLabel = scenes.inventoryUI.findScene("itemName");
        itemNameLabel.richCaption = styled(atlas.addTexture(itemDatabase[item.itemID].icon.assetPath()),Vec2(0,0)).height(height) ~ styled(" " ~ item.getName()).color(Color(150,240,255,255)).font(font).height(height);
        auto itemInfoSystem = scenes.inventoryUI.findScene("itemInfoSystem");
        
    };
    mainInventoryList.onClick = (ListView list, long idx){
        if(idx >= 0 && idx < ItemLists.main.length){
            onInventoryClick("main", idx);
            pocketInventoryList.unSelect();
        }
    };
    pocketInventoryList.onClick = (ListView list, long idx){
        if(idx >= 0 && idx <  ItemLists.pocket.length){
            onInventoryClick("pocket", idx);
            mainInventoryList.unSelect();
        }
    };
    mainInventoryList.onClick = (ListView list, long idx){
        if(idx >= 0 && idx < ItemLists.main.length){
            onInventoryClick("main", idx);
            pocketInventoryList.unSelect();
        }
    };
    mainInventoryList.onDoubleClick = (ListView list, long idx){
        exportItem(selectedItem,"main");
    };
    pocketInventoryList.onDoubleClick = (ListView list, long idx){
        exportItem(selectedItem,"pocket");
    };

    auto particle = scenes.previewCanvas.particleEffect;
    particle.stop();
}



import math;
export double calcCapacity(ItemInfo[] items){
    auto sqrt = math.sqrt;
    auto tidyCap = 0.0;
    auto messyCap = 0.0;
    auto totalWeight = 0.0;
    auto totalSize = 0.0;
    foreach(item ; items){
        auto itemdata = itemDatabase[item.itemID];
        auto weight = itemdata.commonStats.weight;
        auto count = item.count;
        auto size = itemdata.commonStats.size;
        messyCap += count * sqrt(weight*weight + size*size)*100;
        totalWeight += count * weight;
        totalSize += count * size;
    }
    tidyCap = sqrt(totalWeight*totalWeight + totalSize*totalSize)*100;
    auto t = inventoryProfile.tidiable;
    return messyCap*(1.0-t)+tidyCap*t;
}





export void finalize(){
    
}


export void update(){
    auto itemViewer = (any item){
                return styled(atlas.addTexture(itemDatabase[item.itemID].icon.assetPath()),Vec2(0,0)).height(height)
                        ~ (styled(" " ~ item.getName()).color(Color(150,240,255,255))
                        ~ styled(" " ~ itemDataView(item)).color(Color(100,240,190,255))).height(height*0.9).font(font);
            };
    mainInventoryList.richContents =  ItemLists.main.map(itemViewer);
    pocketInventoryList.richContents =  ItemLists.pocket.map(itemViewer);
    
    auto mainCapacityScroll = scenes.inventoryUI.findScene("mainCapacityScroll");
    auto pocketCapacityScroll = scenes.inventoryUI.findScene("pocketCapacityScroll");
    auto mainCapacityLabel = scenes.inventoryUI.findScene("mainCapacityLabel");
    auto pocketCapacityLabel = scenes.inventoryUI.findScene("pocketCapacityLabel");
    
    auto mainCapacity = calcCapacity( ItemLists.main);
    auto pocketCapacity = calcCapacity( ItemLists.pocket);
    mainCapacityScroll.viewportExtent = mainCapacity;
    pocketCapacityScroll.viewportExtent = pocketCapacity;
    mainCapacityScroll.contentExtent = inventoryProfile.capacity;
    pocketCapacityScroll.contentExtent =  pocketProfile.capacity;
    mainCapacityScroll.value = 0;
    pocketCapacityScroll.value = 0;

    mainCapacityLabel.caption  = mainCapacity ~ " / " ~ inventoryProfile.capacity;
    pocketCapacityLabel.caption = pocketCapacity ~ " / " ~ pocketProfile.capacity;

}

ItemInfo[] quickSort(ItemInfo[] inventory, any cmp){
    if(inventory.length <= 1) return inventory;
    auto pivot = inventory[0];
    ItemInfo[] less;
    ItemInfo[] greater;
    foreach(i; 1 .. inventory.length){
        if(cmp(inventory[i], pivot)){
            less ~= inventory[i];
        }else{
            greater ~= inventory[i];
        }
    }
    return quickSort(less, cmp) ~ [pivot] ~ quickSort(greater, cmp);
}
    

export void addItem(ItemInfo item,string listName){
    if(itemDatabase[item.itemID].stackable)
    foreach(existingItem ; ItemLists[listName]){
        if(existingItem.id == item.id){
            existingItem.count += item.count;
            return;
        }
    }
    ItemLists[listName] ~= item;
}

export void removeItem(ItemInfo item,string listName,uint N){
    foreach(idx,existingItem ; ItemLists[listName]){
        if(existingItem.id == item.id){
            if(itemDatabase[item.itemID].stackable) existingItem.count -= N;
            if(!itemDatabase[item.itemID].stackable || existingItem.count <= 0){
                ItemLists[listName] = ItemLists[listName][0..idx] ~ ItemLists[listName][idx+1..$];
            }
            return;
        }
    }
}

export void exportItem(ItemInfo item,string listName){
    
    if(!item) return;
    mainInventoryList.enabled = false;
    pocketInventoryList.enabled = false;

    auto itemData = itemDatabase[item.itemID];
    auto equipItem = equipItemList[itemData.equipSlot];
    if(equipItem){
        addItem(equipItem, listName);
    }
    equipItemList[itemData.equipSlot] = {...item,count = 1};
    removeItem(item,listName,1);
    auto inventorySceneMaster = scenes.root.master;

    self.miniScene((){
        auto particle = scenes.previewCanvas.particleEffect;
        auto backPanel = scenes.inventoryUI.previewPanel;
        auto t0 = 0.5;
        auto t = t0;
        scenes.inventoryUI.previewPanel.isVisible = false;
        while(t > 0){
            particle.endColor = particle.endColor *Color(64,64,64,255);
            particle.lifetime = {min = t*0.5,max = t};
            particle.emit(t/t0*100);
            t -= Timer.dt;
            self.yields;
        }
        inventorySceneMaster.isOFF = true;
    },32);
}

