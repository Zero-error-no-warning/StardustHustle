// FPS履歴はシーンごとに保持し、配列と表示の更新は1秒に一度だけ行います。
instance int[] history = [0,0,0,0,0,0];

auto f = (double t)=>1.*Timer.limitFPS;

export void update(){
    self.everyNsecs(0.5,(){
        auto len = history.length;
        foreach(idx; 0 .. len-1){
            history[idx] = history[idx+1];
        }
        history[len-1] = Timer.fps;
        f = (double t) => 1.*history[cast(int)(t*(len-1))] / cast(double)
        (Timer.limitFPS);
    });
    self.text = styled(Timer.fps) ~ " FPS " ~ styled(f).color(Color(255-255*Timer.fps/Timer.limitFPS,255,0,255));
}
