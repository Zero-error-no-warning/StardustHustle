// Per-scene state: instance int count = 0;
// Private dependency: instance import shared.movement as movement;
// Use self / scene inside functions, after the instance has been attached.
import random;

export void update(){
    self.everyNsecs(random.choice([1.0,1.4,2.3]),
        () :> self.emit(10)
    );
}

export void init(){
    auto map = self.master;
    auto eventIndex = map.eventMarkerIndex("Yuge");
    if(eventIndex >= 0){
        auto marker = map.events[eventIndex];
        self.lp = map.toWorld(marker.p);
    }
}
