
alias ItemType = "weapon_melee" | "weapon_ranged" | "bullet" | "food" | "armor" | "medicine" | "misc";

table Modifier{
    string name;
    ItemType targetType;
}


table ItemInfo{
    uint id;        // 固有ID
    string itemID;   // itemの具体的なデータはitemID先
    uint count;    // アイテムの個数
    string name;    // アイテムの名前
    Modifier[] modifier; // アイテムに付与されている修飾子
    DateTime datetime;
}

table ItemData {
    ItemType type; //sort用
    bool consumable; // 消費可能 かどうか
    double weight; //kg
    double size; //m AABBの対角線
    string description; // アイテムの説明
    string icon; // アイテムのアイコンファイルパス
}

export ItemData[string] itemDatabase = [
    ["knife_001"] : { "weapon_melee", false, 0.5, 0.3, "A sharp knife.", "icons/knife_001.png"},
];

export auto inventoryData = {
    capacity = 100,
    tidiable = 0,
};

import math;
export double calcCapacity(ItemInfo[] items){
    auto tidyCap = 0.0;
    auto messyCap = 0.0;
    auto totalWeight = 0.0;
    auto totalSize = 0.0;
    foreach(item ; items){
        auto itemdata = itemDatabase[item.itemID];
        auto weight = itemdata.weight;
        auto count = item.count;
        auto size = itemdata.size;
        messyCap += count *  sqrt(weight*weight + size*size);
        totalWeight += count * weight;
        totalSize += count * size;
    }
    tidyCap = sqrt(totalWeight*totalWeight + totalSize*totalSize);
    auto t = inventoryData.tidiable;
    return messyCap*(1.0-t)+tidyCap*t;
}



export ItemInfo[] inventory = [
    { id = 1, itemID = "knife_001", count = 1, name = "Knife", modifier = [] },
];


export void initialize(){ 
    auto texts = [];
    auto height = 20.0; 
    auto basePosition = Vec2(0,0);
    foreach(item ; inventory){
        texts ~= newText();
        
        texts[$-1].p = basePosition + height*Vec2(1,texts.length-1);
        texts[$-1].text = styled(item.name).height(height);
    }
}

export void finalize(){
    
}


export void update(){

}

export void addItem(ItemInfo item){
    foreach(existingItem ; inventory){
        if(existingItem.itemID == item.itemID && existingItem.modifier == item.modifier){
            existingItem.count += item.count;
            return;
        }
    }
    inventory ~= item;
}

export void removeItem(ItemInfo item){
    foreach(idx,existingItem ; inventory){
        if(existingItem.itemID == item.itemID && existingItem.modifier == item.modifier){
            existingItem.count -= item.count;
            if(existingItem.count <= 0){
                inventory = inventory[0..idx] ~ inventory[idx+1..$];
            }
            return;
        }
    }
}