// Sceneごとの状態: instance int count = 0;
// selfはこのコードを割り当てたSceneです。
import scenes;

import script.database.itemData as idata;
auto inventory = scenes.inventory;

auto player = null;
auto rightHand = null;
auto leftHand = null;

 bool _isReady = false;

export bool isReady(){
    return _isReady;
}

export void init(){
    player = scenes.player;
    rightHand = player.part("右手");
    leftHand = player.part("左手");
    player.morph("walk",0.1);

    
    auto WeaponState = self.stateMachine("WeaponState");
    auto v = 0.0;
    auto particle = scenes.particleEffect;
    auto diff0 = 75.;
    Character chara = null;
    WeaponState["CatchStart"] = (){
        _isReady = false;
        foreach(sub;self.subs){
            if(sub.type == "Character")
                sub.exit();
        }
        auto iModule = inventory.findScene("inventoryUI").sceneModule();
        auto weapon = iModule.equipItemList["weapon"];
        auto asset = iModule.itemAssets[idata.getModel(weapon)];
        auto canvas = self.targetCanvas();
        chara = asset.spawn(canvas);
        chara.scale = 0.5;
        auto dx = chara.part("modelCenter").p-chara.p;
        idata.setWeaponVariant(weapon,chara);
        
        chara.p = player.p + Vec2(0,-diff0)-dx;
        chara.z = 50;
        particle.p = chara.part("modelCenter").p;
        particle.z = chara.z  + 50;
        v = 0;
        WeaponState.changeState("Catching");
    };
    WeaponState["Catching"] = (){
        auto diff = player.part("右手").p.y - chara.p.y;
        particle.endColor = particle.endColor *Color(64,64,64,255);
        particle.emit(diff/diff0*50);
        v += 5.*self.dt;
        player.clearMorphParts("ArmR",0.0);
        player.morph("catchItem",0.3);
        chara.p.y = chara.p.y + v;
        if(player.part("右手").p.y <= chara.p.y) WeaponState.changeState("Caught");
    };
    WeaponState["Caught"] = (){
        _isReady = true;
        player.morph("caughtItem",0.3);
        self.addSubScene(chara);
        chara.lz = 50;
        chara.lp = Vec2(0,0 );
        auto iModule = inventory.findScene("inventoryUI").sceneModule();
        auto weapon = iModule.equipItemList["weapon"];
        auto hand = iModule.equipItemList["none"];
        auto idatabase = iModule.itemDatabase;
        if(weapon) {
            auto wdata = idatabase[weapon.itemID];
            if(wdata.tag == "handgun"){
                WeaponState.changeState("Got_Onehand_ranged");
                return;
            }
        }
        WeaponState.changeState("None");
    };
    WeaponState["None"] = (){
        self.p = rightHand.p;
        self.a = rightHand.a + Angle.Deg(90);
        self.z = rightHand.z;
    };
    WeaponState["Got_Onehand_ranged"] = (){
        self.p = rightHand.p;
        self.a = rightHand.a ;
        self.z = rightHand.z;
        self.firstTime(recoilTime > 0.,(){
            player.clearMorphParts("ArmR");
            player.morphPartsTimed("ArmR","onehandGunRecoil",recoilTime,0.01);
            
            auto effect = chara.newExternalScene("./fireEffect.zscene".assetPath());
            effect.p = chara.part("firepoint0").p;
            effect.scale = 2;
        });
        if(recoilTime > 0.){
            recoilTime -= self.dt;
        }
        else{
            player.morphParts("ArmR","onehandGun",0.3);
        }
        
    };
    WeaponState.changeState("None");
}
export void updateModel(){
    self.stateMachine("WeaponState").changeState("CatchStart");    
}
export void update(){
}

export void equipAnimation(Character chara){
    
}
double recoilTime = 0.;
export void fire(double recoilTime_){
    recoilTime = recoilTime_;
}