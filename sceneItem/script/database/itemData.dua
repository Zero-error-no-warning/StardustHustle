export alias ItemType = "weapon_melee" | "weapon_ranged" | "gun_parts" | "magic_stone" |  "ammo" | "food" | "armor" | "medicine" | "misc";

export alias EquipSlot = "weapon" | "none" | "head" | "body" | "waist" | "gunparts";
alias GunPartsKind = "barrel" | "stock" | "scope" | "magazine" | "grip" | "slide" | "receiver" | null;

export table ItemData { //個体差のない基本データ
    ItemType type;
    string baseName;
    bool consumable = false;
    bool stackable = false;
    EquipSlot equipSlot;
    string description;
    string icon;
    string model;
    CommonData commonData; // 共通の基本性能
    SpecificData specificData; // アイテム固有性能
    GunSlot[] slots = [];     // 対応部位
    GunPartsKind gunpartsKind = null;
    string tag;
}
alias SpecificData = ConsumptData[] | WeaponData | null;

export table CommonData { double weight; double size; double value; }


alias ConsumptEffectType = "health" | "stamina" |"fastMove" | "fastSwing" | "fastReload" | "lowSpread" | "fastHeal" | "fastSearch";
table ConsumptEffect { ConsumptEffectType type; double value; double duration; }
table ConsumptData  {double satiety; ConsumptEffect[] effect;}

export table WeaponData { 
    double sharpDamage = 0.0;
    double hardDamage = 0.0;
    double fireRate = 0.0;
    double bulletSpread = 0.0;
    double bulletSpeed = 0.0;
    double reloadSpeed = 0.0;
    int magazineSize = 0;
}

table GunSlot { string id; GunPartsKind kind; string[] acceptTags; }

export table ItemState { // アイテムの個体情報
    int id;
    string itemID;
    int count;
    string name;
    any datetime;                   // 元のDateTimeを保持する欄。
    GunState gunState  = null;
    WeaponEffect weaponEffect = null;
    CommonEffect commonEffect = null;
    ItemState[GunPartsKind] slot = [:];
}


table CommonEffect {...CommonData;}
table WeaponEffect {...WeaponData;}


export table GunState {
    int loadedAmmo = 0;
}

////////// 1. 製品固定データ：共通値と各カテゴリの専用値 //////////

