//////////  補助関数

export string getName(ItemState item){
    return item.name == "" ?  itemDatabase[item.itemID].baseName : item.name;
}
export double getActualWeight(ItemState item){
    auto itemData = itemDatabase[item.itemID];
    double weight = itemData.commonData.weight;
    if(item.commonEffect)
        weight += item.commonEffect.weight;
    return weight;
}
export double getActualValue(ItemState item){
    auto itemData = itemDatabase[item.itemID];
    double value = itemData.commonData.value;
    if(item.commonEffect)
        value += item.commonEffect.value;
    return value;
}
export double getActualSize(ItemState item){
    auto itemData = itemDatabase[item.itemID];
    double size = itemData.commonData.size;
    if(item.commonEffect)
        size += item.commonEffect.size;
    return size;
}

export WeaponData getActualWeaponData(ItemState item){
    auto itemData = itemDatabase[item.itemID];
    if(itemData.type != "weapon_ranged" && itemData.type != "weapon_melee") return WeaponData{fireRate = 0.0};

    WeaponData actualData = {...itemData.specificData};
    if(item.weaponEffect){
        actualData.sharpDamage += item.weaponEffect.sharpDamage;
        actualData.hardDamage += item.weaponEffect.hardDamage;
        actualData.fireRate += item.weaponEffect.fireRate;
        actualData.bulletSpread += item.weaponEffect.bulletSpread;
        actualData.bulletSpeed += item.weaponEffect.bulletSpeed;
        actualData.reloadSpeed += item.weaponEffect.reloadSpeed;
        actualData.magazineSize += item.weaponEffect.magazineSize;
    }
    return actualData;
}

export string getModel(ItemState item){
    auto itemData = itemDatabase[item.itemID];
    return itemData.model.assetPath();
}

export string getTag(ItemState item){
    auto itemData = itemDatabase[item.itemID];
    return itemData.tag;
}

export void setWeaponVariant(ItemState weapon,Character chara){
    foreach(key,part; chara.parts){
        chara.selectLayerVariant(part,0);
    }
    foreach(key,mod; weapon.slot){
        auto tag = getTag(mod);
        chara.selectLayerVariant(key,key,tag);
    }
}