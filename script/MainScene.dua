// Sceneごとの状態: instance int count = 0;
// selfはこのコードを割り当てたSceneです。

import scenes;
auto mainCanvas = scenes.MainCanvas;
auto inventory = scenes.inventory;  
auto sounds = scenes.MainCanvas.sound;
auto InventoryKey = KeyConfig.Set("Inventory");
auto standLight = scenes.leftCanvas.stand_point;
auto InventoryState = null;

export void init(){
    Mouse.cursorDisplay = false;
    Timer.limitFPS = 120;
    KeyConfig["PlayerMove"].current = {
        MoveFront  =  InputStatus("?Shift W"),
        MoveBack   =  InputStatus("?Shift S"),
        MoveLeft   =  InputStatus("?Shift A"),
        MoveRight  =  InputStatus("?Shift D"),
        Dash       =  InputStatus("Shift *"),
    };
    KeyConfig["Inventory"].current = {
        OpenCloseInventory = InputStatus("Tab"),
    };

    standLight.color = Color(255,255,0,255) ;
    InventoryState = self.stateMachine("InventoryState");
    InventoryState.doState("InventoryClosed",(){
        self.firstTime(true,(){
            Mouse.p = mainCanvas.sceneModule().targetPosition;
            inventory.isOFF = true;
            Mouse.cursorDisplay = false;
            mainCanvas.isFreeze = false;
            standLight.color =Color(255,255,0,255) ;
            foreach(sound ; sounds.subs()){
                sound.play(false);
            }
        });
        if(KeyConfig["Inventory"].isClicked("OpenCloseInventory")){
            InventoryState.changeState("InventoryOpened");
        }
    });
    InventoryState.doState("InventoryOpened",(){
        self.firstTime(true,(){
            inventory.isOFF = false;
            inventory.findScene("inventoryUI").sceneModule().open();
            Mouse.cursorDisplay = true;
            mainCanvas.isFreeze = true;
            standLight.color = Color(50,255,255,255);
            foreach(sound ; sounds.subs()){
                sound.stop();
            }
        });
        self.firstTime( inventory.isOFF || KeyConfig["Inventory"].isClicked("OpenCloseInventory"),(){
            auto weaponsModule = scenes.leftCanvas.stand_items.findModule("item");
            if(inventory.isOFF) {self.miniScene((){
                    weaponsModule.updateModel();
                    self.yields;
                    InventoryState.changeState("InventoryClosed");
                });
            }
            else{
                InventoryState.changeState("InventoryClosed");
            }
        });
    });
    InventoryState.changeState("InventoryClosed");
}

export void update(){
}
