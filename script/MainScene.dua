// Sceneごとの状態: instance int count = 0;
// selfはこのコードを割り当てたSceneです。

import scenes;
auto mainCanvas = scenes.MainCanvas;
auto inventory = scenes.inventory;  
auto sounds = scenes.MainCanvas.sound;
auto InventoryKey = KeyConfig.Set("Inventory");
auto standLight = scenes.leftCanvas.stand_point;

export void init(){
    Mouse.cursorDisplay = false;
    Timer.limitFPS = 120;
    KeyConfig["PlayerMove"].current = {
        MoveFront  =  InputStatus("?Shift W"),
        MoveBack   =  InputStatus("?Shift S"),
        MoveLeft   =  InputStatus("?Shift A"),
        MoveRight  =  InputStatus("?Shift D"),
        Dash       =  InputStatus("Shift *"),
    };
    KeyConfig["Inventory"].current = {
        OpenCloseInventory = InputStatus("Tab"),
    };

    standLight.color = Color(255,255,0,255) ;
}

export void update(){
    if(KeyConfig["Inventory"].isClicked("OpenCloseInventory")){
        mainCanvas.isFreeze = !mainCanvas.isFreeze;
        inventory.isOFF = !mainCanvas.isFreeze;
        Mouse.cursorDisplay = !inventory.isOFF;
        standLight.color = inventory.isOFF ? Color(255,255,0,255) : Color(50,255,255,255);
        if(inventory.isOFF){
            Mouse.p = mainCanvas.sceneModule().targetPosition;
            foreach(sound ; sounds.subs()){
                sound.play(false);
            }
        }
        else{
            print(sounds.subs());
            foreach(sound ; sounds.subs()){
                sound.stop();
            }
        }
    }
}
