// Sceneごとの状態: instance int count = 0;
// selfはこのコードを割り当てたSceneです。
import scenes;


import sceneItem.script.database.itemData as idata;
instance double speed = 60.0;

double cameraSpan = 3.0;
double minAimDistance = 30.0;
double maxAimDistance = 200.0;
double scopeZoom =1.0;
double aimDistance = cameraSpan;

auto lerp = (Vec2 a, Vec2 b, double t) => a*(1-t) + b*t;

auto mainCanvas = scenes.MainCanvas;
    
auto self_motions = {};
Vec2 targetPosition = Vec2.Zero;

auto stand_motions = {};
auto stand = null;

alias WeaponData = idata.WeaponData;
WeaponData weaponData = WeaponData{};


export void init(){
    auto physics = self.master;
    auto map = scenes.MainCanvas.findScene("stage").findScene("map");
    auto eventIndex = map.eventMarkerIndex("SpawnPoint");
    if(eventIndex >= 0){
        auto marker = map.events[eventIndex];
        physics.p = map.toWorld(marker.p);
    }

    targetPosition = sceneModule(mainCanvas).targetPosition;
    self_motions = {
        idle = self.motionIndex("idle"),
        walkFront = self.motionIndex("walkFront"),
        holdHandgun = self.motionIndex("holdHandgun"),
    };
    stand = scenes.leftCanvas.stand_player;
    stand_motions = {
        blink = stand.motionIndex("blink"),
        walk = stand.motionIndex("walk"),
        idle = stand.motionIndex("idle"),
        holdLantern = stand.motionIndex("holdLantern"),
        holdHandgun = stand.motionIndex("holdHandgun"),
    };

    self.motionSpeed = 1.0;
    stand.motionSpeed = 1.0;
    physics.z = 0;

    auto weapon = self.stateMachine("weapon");
    weapon["subMachineGun"] = (){
        self.clearMorphParts("Torso");
        self.morphParts("ArmR", self.motionIndex("holdSubMachineGun"),0.3);
        self.morphParts("ArmL", self.motionIndex("holdSubMachineGun"),0.3);
        self.morphParts("Head", self.motionIndex("holdSubMachineGun"),0.3);
        self.morphPartOnly("Torso", self.motionIndex("holdSubMachineGun"),0.3);
        self.morphPartOnly("Waist", self.motionIndex("holdSubMachineGun"),0.3);
        self.part("weapons").isOFF = false;
        if(Mouse.isPressed("Left") && self.everyNsecs(0.1)){
            auto firePoint = self.part("firePointSMG");
            auto physicsSpace = scenes.MainCanvas.physicsSpace;
            auto bullet = physicsSpace.newExternalScene("./sceneItem/bullet.zscene".assetPath());
            auto effect = self.newExternalScene("./sceneItem/fireEffect.zscene".assetPath());
            effect.p = firePoint.p;
            bullet.p = firePoint.p;
            bullet.a = self.a;
            bullet.findScene("SMG").setPhysicsVelocity(Vec3(Vec2(1000,0).rot(bullet.a),0));
            auto fireSound = scenes.MainCanvas.sound.gunfire;
            fireSound.play();
        }
        if(Mouse.isPressed("Right")){

        }
    };
    weapon["handgun"] = (){
        self.clearMorphParts("Torso");
        self.morphParts("ArmR", self.motionIndex("holdHandGun"),0.3);
        stand.morphParts("ArmR",stand.motionIndex("onehandGun"),0.3);
        if(Mouse.oncePressed("Left") && self.everyNsecs(1./weaponData.fireRate)){
            auto firePoint = self.part("firePointHandgun");
            auto physicsSpace = scenes.MainCanvas.physicsSpace;
            auto effect = self.newExternalScene("./sceneItem/fireEffect.zscene".assetPath());
            effect.p = firePoint.p;
            
            auto bullet = physicsSpace.newExternalScene("./sceneItem/bullet.zscene".assetPath());
            bullet.p = firePoint.p;
            bullet.a = self.a;
            bullet.findScene("SMG").setPhysicsVelocity(Vec3(Vec2(1000,0).rot(bullet.a),0));
            auto fireSound = scenes.MainCanvas.sound.gunfire;
            fireSound.play();

            auto stand_items  = scenes.leftCanvas.stand_items.findModule("item");
            stand_items.fire(0.2);
            self.morphPartsTimed("ArmR","recoilHandGun",0.1,0.01);
        }
    };
    weapon["onehandshort"] = (){
    };
    weapon["none"] = (){
        self.clearMorphParts("");
        stand.clearMorphParts("");
    };
    weapon.changeState("handgun");

    self.doAlways((){
        auto inventory = scenes.inventory.findModule("inventoryUI");
        auto eqWeapon = inventory.equipItemList["weapon"];
        if(eqWeapon){
            auto eqWeaponData = idata.itemDatabase[eqWeapon.itemID];
            weaponData = idata.getActualWeaponData(eqWeapon);
            weapon.changeState(eqWeaponData.tag);
        }
        else{
            weapon.changeState("none");
        }
    });
}


void mosueUpdate(){
    auto physics = self.master;
    auto dp = Mouse.p - targetPosition;
    auto len = (targetPosition.toCanvas(mainCanvas)-self.p).norm;
    auto da = dp.x / len ;
    auto dr = dp.y / len ;
    physics.a = physics.a + da;
    mainCanvas.camera.zoom += dr;
    import math;

    mainCanvas.camera.zoom = math.clamp(mainCanvas.camera.zoom, 0.2, 2.0);
    Mouse.p = targetPosition;
}

auto mainCanvasScript = sceneModule(mainCanvas);
auto playerMove = KeyConfig.Set("PlayerMove");

export void update(){

    Vec2 moveInput = Vec2(0, 0);
    if(playerMove.isPressed("MoveFront"))
        moveInput.x = moveInput.x + 1;
    if(playerMove.isPressed("MoveBack"))
        moveInput.x = moveInput.x - 1;
    if(playerMove.isPressed("MoveLeft"))
        moveInput.y = moveInput.y - 1;
    if(playerMove.isPressed("MoveRight"))
        moveInput.y = moveInput.y + 1;
        
    
    // Vec3 v = Vec3(0,0,0);
    // v.xy = moveInput.unit.rot(self.a) * speed;
    
    Vec3 v = Vec3( moveInput.unit.rot(self.a) * speed);
    auto physics = self.master;
    if(playerMove.isPressed("Dash")){
        print(v.norm , " =>  " , (v * 2.0).norm);
        v = v * 2.0;
    }
    physics.setPhysicsVelocity(v);  

    if(v.norm > 0)
        self.morph(self_motions.walkFront,0.3);
    else{
        self.morph(self_motions.idle,0.3);
    }

    if(moveInput.norm > 0){
        stand.morph(stand_motions.walk,0.3);
        stand.motionSpeed = v.norm / speed;
    }
    else{
        stand.morph(stand_motions.idle,0.3);
    }
    self.everyNsecs(5,(){
        stand.morphParts("Eye",stand_motions.blink,0.0,1);
    });
    

    auto footSound = scenes.MainCanvas.sound.footsteps;
    if (self.selectedMotionIndex == self_motions.walkFront) {
        if (!footSound.isPlaying)
            self.everyNsecs(0.05*v.norm/speed,(){
                footSound.play(false); // 続きから再開
            });
    } else {
        if (footSound.isPlaying)
            footSound.stop();      // 再生位置を保持して停止
    }
    mosueUpdate();


}